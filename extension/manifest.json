{
  "manifest_version": 3,
  "name": "promptSathi \u2014 your prompt friend",
  "version": "0.1.0",
  "description": "Improves your prompt the moment you hit Enter (ChatGPT, Claude, Gemini) and adds voice input in Nepali, Hindi and English. Free, stateless, no accounts.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.workers.dev/*",
    "https://api.groq.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://bard.google.com/*",
    "https://grok.x.ai/*",
    "https://x.ai/*",
    "https://z.ai/*",
    "https://chat.z.ai/*",
    "https://chat.deepseek.com/*",
    "https://deepseek.com/*",
    "https://perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://poe.com/*",
    "https://huggingface.co/*",
    "https://hf.co/*",
    "https://you.com/*",
    "https://phind.com/*",
    "https://chat.mistral.ai/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "promptSathi"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://bard.google.com/*",
        "https://grok.x.ai/*",
        "https://x.ai/*",
        "https://z.ai/*",
        "https://chat.z.ai/*",
        "https://chat.deepseek.com/*",
        "https://deepseek.com/*",
        "https://perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://poe.com/*",
        "https://huggingface.co/*",
        "https://hf.co/*",
        "https://you.com/*",
        "https://phind.com/*",
        "https://chat.mistral.ai/*",
        "https://grok.com/*"
      ],
      "js": [
        "content/sites.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/sathi.css",
        "icons/*.png"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://bard.google.com/*",
        "https://grok.x.ai/*",
        "https://x.ai/*",
        "https://z.ai/*",
        "https://chat.z.ai/*",
        "https://chat.deepseek.com/*",
        "https://deepseek.com/*",
        "https://perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://poe.com/*",
        "https://huggingface.co/*",
        "https://hf.co/*",
        "https://you.com/*",
        "https://phind.com/*",
        "https://chat.mistral.ai/*",
        "https://grok.com/*"
      ]
    }
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}